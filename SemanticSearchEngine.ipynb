      "source": [
        "# Load the dataset\n",
        "dataset = load_dataset(\"nthakur/msmarco-passage-sampled-100k\")\n",
        "\n",
        "#Test train and validation split using a random seed\n",
        "random_seed = random.randint(0, 1000000)\n",
        "print(f\"Using Randomly Generated Seed: {random_seed}\")\n",
        "\n",
        "split_1 = dataset['train'].train_test_split(train_size=0.90, seed=random_seed)\n",
        "split_2 = split_1['test'].train_test_split(test_size=0.50, seed=random_seed)\n",
        "\n",
        "train_ds = split_1['train']\n",
        "valid_ds = split_2['train']\n",
        "test_ds  = split_2['test']"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "GG4JplhHlQqd"
      },
      "outputs": [],
      "source": [
        "# Preprocessing\n",
        "train_ds = train_ds.rename_columns({\"query\": \"anchor\", \"positive_passages\": \"positive\", \"negative_passages\": \"negative\"})\n",
        "valid_ds = valid_ds.rename_columns({\"query\": \"anchor\", \"positive_passages\": \"positive\", \"negative_passages\": \"negative\"})\n",
        "test_ds = test_ds.rename_columns({\"query\": \"anchor\", \"positive_passages\": \"positive\", \"negative_passages\": \"negative\"})\n",
        "\n",
        "def flatten_data(example):\n",
        "    example['positive'] = example['positive'][0]['text']\n",
        "    example['negative'] = example['negative'][0]['text']\n",
        "    return example\n",
        "\n",
        "train_ds = train_ds.map(flatten_data)\n",
        "valid_ds = valid_ds.map(flatten_data)\n",
        "test_ds = test_ds.map(flatten_data)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "B-p42v5SmCTO"
      },
      "outputs": [],
      "source": [
        "#Load model and set up loss function\n",
        "model = SentenceTransformer('all-MiniLM-L6-v2')\n",
        "train_loss = losses.MultipleNegativesRankingLoss(model)\n",
        "\n",
        "#Correct columns\n",
        "train_ds = train_ds.select_columns(['anchor', 'positive', 'negative'])\n",
        "valid_ds = valid_ds.select_columns(['anchor', 'positive', 'negative'])\n",
        "\n",
        "\n",
        "#Training parameters for Colab T4 GPU with 100k samples\n",
        "args = SentenceTransformerTrainingArguments(\n",
        "    output_dir=\"TunedModel\",\n",
        "    num_train_epochs=1,\n",
        "    per_device_train_batch_size=32,\n",
        "    gradient_accumulation_steps=2,\n",
        "    learning_rate=2e-5,\n",
        "    warmup_steps=150,\n",
        "    fp16=True,\n",
        "    eval_strategy=\"steps\",\n",
        "    eval_steps=500,\n",
        "    save_steps=500,\n",
        "    load_best_model_at_end=True,\n",
        "    metric_for_best_model=\"eval_loss\",\n",
        ")\n",
        "\n",
        "#Start Training\n",
        "trainer = SentenceTransformerTrainer(\n",
        "    model=model,\n",
        "    args=args,\n",
        "    train_dataset=train_ds,\n",
        "    eval_dataset=valid_ds,\n",
        "    loss=train_loss,\n",
        ")\n",
        "\n",
        "trainer.train()\n",
        "model.save(\"TunedModel\")"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "q_R8cE6Tol5v"
      },
      "outputs": [],
      "source": [
        "#FAISS Index\n",
        "corpus_sentences = ( [row['positive'] for row in train_ds] +  [row['positive'] for row in valid_ds] +  [row['positive'] for row in test_ds])\n",
        "\n",
        "corpus_embeddings = model.encode(\n",
        "    corpus_sentences,\n",
        "    batch_size=128,\n",
        "    show_progress_bar=True,\n",
        "    convert_to_numpy=True\n",
        ")\n",
        "\n",
        "d = corpus_embeddings.shape[1]\n",
        "index = faiss.IndexFlatL2(d)\n",
        "index.add(corpus_embeddings.astype('float32'))\n",
        "\n",
        "#Cross Encoder\n",
        "reranker = CrossEncoder('cross-encoder/ms-marco-MiniLM-L-6-v2')\n",
        "\n",
        "def advanced_search(query, top_k_faiss=100, final_k=10):\n",
        "\n",
        "    query_vector = model.encode([query]).astype('float32')\n",
        "    distances, indices = index.search(query_vector, top_k_faiss)\n",
        "    candidate_texts = [corpus_sentences[i] for i in indices[0]]\n",
        "\n",
        "\n",
        "    pairs = [[query, doc] for doc in candidate_texts]\n",
        "    scores = reranker.predict(pairs)\n",
        "\n",
        "\n",
        "    results = sorted(zip(candidate_texts, scores), key=lambda x: x[1], reverse=True)\n",
        "    return results[:final_k]"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "O1iM2r9htpQD"
      },
      "outputs": [],
      "source": [
        "#Query selection\n",
        "test_queries = [row['anchor'] for row in test_ds.select(range(100))]\n",
        "test_targets = [row['positive'] for row in test_ds.select(range(100))]\n",
        "\n",
        "def run_performance_benchmarks(queries, targets, k_vals=[1, 5, 10, 20]):\n",
        "    results_metrics = {\n",
        "        'mrr': [], 'latencies': [],\n",
        "        'ndcg': {k: [] for k in k_vals},\n",
        "        'recall': {k: [] for k in k_vals}\n",
        "    }\n",
        "\n",
        "    for q, target in zip(queries, targets):\n",
        "        target_clean = target.strip().lower()\n",
        "\n",
        "        t_start = time.perf_counter()\n",
        "        search_hits = advanced_search(q, final_k=20)\n",
        "        results_metrics['latencies'].append((time.perf_counter() - t_start) * 1000)\n",
        "\n",
        "        retrieved_texts = [hit[0] for hit in search_hits]\n",
        "\n",
        "        rank = -1\n",
        "        for i, text in enumerate(retrieved_texts):\n",
        "            if target_clean in text.strip().lower():\n",
        "                rank = i + 1\n",
        "                break\n",
        "\n",
        "        #Calculations\n",
        "        results_metrics['mrr'].append(1/rank if rank != -1 else 0)\n",
        "        for k in k_vals:\n",
        "            found_in_k = any(target_clean in t.strip().lower() for t in retrieved_texts[:k])\n",
        "            results_metrics['recall'][k].append(1 if found_in_k else 0)\n",
        "            results_metrics['ndcg'][k].append(1/np.log2(rank + 1) if (rank != -1 and rank <= k) else 0)\n",
        "\n",
        "    #Output table\n",
        "    print(f\"\\nSummary\")\n",
        "    print(f\"Mean MRR: {np.mean(results_metrics['mrr']):}\")\n",
        "    print(f\"P95 Latency: {np.percentile(results_metrics['latencies'], 95):}ms\")\n",
        "    print(\"Metric | @1 | @5 | @10 | @20\")\n",
        "    for m in ['ndcg', 'recall']:\n",
        "        row = f\"{m.upper()}\"\n",
        "        for k in k_vals:\n",
        "            row += f\" | {np.mean(results_metrics[m][k]):}\"\n",
        "        print(row)\n",
        "\n",
        "run_performance_benchmarks(test_queries, test_targets)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "_VrM6CBZv3Z-"
      },
      "outputs": [],
      "source": [
        "#Search Engine\n",
        "def run_cli():\n",
        "    print(\"Search Engine\")\n",
        "    print(\"Type 'exit' to quit\\n\")\n",
        "\n",
        "    while True:\n",
        "        query = input(\"Enter your search: \")\n",
        "        if query.lower() == 'exit':\n",
        "            break\n",
        "\n",
        "        if not query.strip():\n",
        "            continue\n",
        "\n",
        "        while True:\n",
        "            k_input = input(\"How many results? \")\n",
        "            if k_input.strip().isdigit():\n",
        "                k = int(k_input)\n",
        "                break\n",
        "            print(\"Invalid input ,type a number\")\n",
        "\n",
        "        start = time.time()\n",
        "        results = advanced_search(query, final_k=k)\n",
        "        duration = (time.time() - start) * 1000\n",
        "\n",
        "        print(f\"\\nFound {len(results)} results ({duration:.0f}ms)\\n\")\n",
        "        for i, (text, score) in enumerate(results, 1):\n",
